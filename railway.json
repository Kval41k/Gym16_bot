{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "test -n \"$RAILWAY_VOLUME_MOUNT_PATH\" && python run.py",
    "healthcheckPath": "/api/ready",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "sleepApplication": false
  }
}
