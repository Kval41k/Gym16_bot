BOT_TOKEN=
ADMIN_IDS=
ADMIN_USERNAME=
BASE_URL=https://your-service.onrender.com
CORS_ORIGINS=
DATABASE_URL=
UPLOAD_DIR=
BOT_STORAGE_URL=
# ADMIN_USERNAME is deprecated and ignored. Only numeric ADMIN_IDS grant access.
AUTH_MAX_AGE=7200
UPLOAD_USER_QUOTA_MB=100
UPLOAD_TOTAL_QUOTA_MB=1024
UPLOAD_MIN_FREE_MB=128
UPLOAD_ORPHAN_DAYS=7
BACKUP_DIR=
# Optional private S3/R2 storage. Never use a publicly readable bucket.
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_MEDIA_ENABLED=false
BACKUP_REMOTE_ENABLED=false
BACKUP_ENCRYPTION_KEY=
BACKUP_REMOTE_KEEP=30
# Enable after database, media and encrypted offsite backup are all connected.
REQUIRE_PERSISTENT_STORAGE=false
